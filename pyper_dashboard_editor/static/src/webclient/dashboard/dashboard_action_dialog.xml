<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pyper_dashboard_editor.DashboardActionDialog" t-inherit="pyper_dashboard_editor.DashboardDialogBase" t-inherit-mode="primary">
        <xpath expr="//t[@t-slot='default']" position="inside">
            <div class="d-flex flex-column flex-md-row gap-3 pyper_dashboard--action-dialog">
                <!-- Left sidebar: configuration -->
                <div class="pyper_dashboard--action-dialog-sidebar border rounded p-3">
                    <!-- Model -->
                    <div class="mb-3">
                        <label class="o_form_label mb-2" for="model_0">
                            Model
                        </label>

                        <div t-att-class="{'border border-danger rounded': state.errors.model}">
                            <ModelSelector
                                id="'model_0'"
                                value="state.modelLabel"
                                onModelSelected.bind="onModelSelected"
                            />
                        </div>
                    </div>

                    <!-- Type -->
                    <div class="mb-3">
                        <label class="o_form_label mb-2">
                            Type
                        </label>

                        <SelectMenu
                            choices="actionTypeChoices"
                            value="state.type"
                            onSelect.bind="onTypeChanged"
                            required="true"
                            autoSort="false"
                        />
                    </div>

                    <!-- Action (only for type 'action' and model selected) -->
                    <div class="mb-3" t-if="state.type === 'action' and state.modelName">
                        <label class="o_form_label mb-2">
                            Action
                        </label>

                        <div t-att-class="{'border border-danger rounded': state.errors.action}">
                            <RecordSelector
                                resModel="'ir.actions.act_window'"
                                resId="state.selectedActionId"
                                domain="actionDomain"
                                update.bind="onActionSelected"
                            />
                        </div>
                    </div>

                    <!-- View type -->
                    <div class="mb-3" t-if="state.modelName and !isKpiType">
                        <label class="o_form_label mb-2">
                            View type
                        </label>

                        <SelectMenu
                            choices="viewTypeChoices"
                            value="state.viewMode"
                            onSelect.bind="onViewModeChanged"
                            required="true"
                            autoSort="false"
                        />
                    </div>

                    <!-- Filter field -->
                    <div class="mb-3" t-if="state.modelName">
                        <label class="o_form_label mb-2">
                            Filter field
                        </label>

                        <ModelFieldSelector
                            resModel="state.modelName"
                            path="state.filterField"
                            readonly="false"
                            allowEmpty="true"
                            followRelations="false"
                            filter="filterFieldFilter"
                            update.bind="onFilterFieldUpdate"
                        />
                    </div>

                    <!-- Options -->
                    <h6 class="mt-4 mb-0">Options</h6>
                    <hr class="mt-1 mb-3"/>

                    <!-- Title -->
                    <div class="mb-3">
                        <label class="o_form_label mb-2" for="title_0">
                            Title
                        </label>

                        <input type="text"
                               id="title_0"
                               t-model="title.input.value"
                               class="o_input"
                               t-att-class="{'is-invalid': title.input.hasError}"
                               autocomplete="nope"
                        />
                    </div>

                    <!-- Icon -->
                    <div class="mb-3">
                        <label class="o_form_label mb-2" for="icon_0">
                            Icon
                        </label>

                        <input type="text"
                               id="icon_0"
                               t-model="icon.input.value"
                               class="o_input"
                               autocomplete="nope"
                               placeholder="fa fa-users"
                        />
                    </div>

                    <!-- Heights -->
                    <t t-if="!isKpiType">
                        <div class="mb-3">
                            <label class="o_form_label mb-2" for="height_0">
                                Height
                            </label>

                            <input type="text"
                                   id="height_0"
                                   t-model="height.input.value"
                                   class="o_input"
                                   t-att-class="{'is-invalid': height.input.hasError}"
                                   autocomplete="nope"
                                   placeholder="auto"
                            />
                        </div>

                        <div class="mb-3">
                            <label class="o_form_label mb-2" for="min_height_0">
                                Min Height
                            </label>

                            <input type="text"
                                   id="min_height_0"
                                   t-model="minHeight.input.value"
                                   class="o_input"
                                   t-att-class="{'is-invalid': minHeight.input.hasError}"
                                   autocomplete="nope"
                                   placeholder="auto"
                            />
                        </div>

                        <div class="mb-3">
                            <label class="o_form_label mb-2" for="max_height_0">
                                Max Height
                            </label>

                            <input type="text"
                                   id="max_height_0"
                                   t-model="maxHeight.input.value"
                                   class="o_input"
                                   t-att-class="{'is-invalid': maxHeight.input.hasError}"
                                   autocomplete="nope"
                                   placeholder="auto"
                            />
                        </div>
                    </t>
                </div>

                <!-- Right: preview -->
                <div class="d-flex flex-column flex-grow-1 min-w-0">
                    <t t-if="state.showPreview">
                        <t t-if="isKpiType">
                            <DashboardKpiPreview t-key="state.previewKey" t-props="previewProps"/>
                        </t>
                        <t t-else="">
                            <DashboardPreview t-key="state.previewKey" t-props="previewProps"/>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="d-flex align-items-center justify-content-center h-100 text-muted border rounded p-3">
                            Select a model to preview
                        </div>
                    </t>
                </div>
            </div>
        </xpath>

        <xpath expr="//button[hasclass('btn-secondary')]" position="after">
            <button t-if="isDebugMode and props.actionData" class="btn btn-link ms-auto" t-on-click="showArchDialog">
                <i class="fa fa-bug me-1"/>XML
            </button>
        </xpath>
    </t>
</templates>
