<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class">#{'col-5 mt-3' if report_type == 'pdf' else 'col-12 col-md-5'} d-inline-block float-end</attribute>
        </xpath>

        <xpath expr="//div[@id='right-elements']" position="before">
            <div id="left-elements" t-attf-class="#{'col-6 mt-3' if report_type == 'pdf' else 'col-12 col-md-6'} d-inline-block">
                <table
                    t-if="o.display_bank_account_on_document"
                    class="table table-sm"
                    style="text-wrap: nowrap; border-color: transparent !important;"
                >
                    <tr class="o_subtotal" style="border-color: transparent !important;">
                        <td colspan="2" style="border-color: transparent !important;">
                            <strong class="me-3">Bank account</strong>
                        </td>
                    </tr>

                    <tr class="o_subtotal" style="border-color: transparent !important;">
                        <td style="border-color: transparent !important;" width="1px;">
                            <strong class="me-3">IBAN</strong>
                        </td>

                        <td style="border-color: transparent !important;">
                            <span t-out="o.partner_bank_id.acc_number">IBAN Number</span>
                        </td>
                    </tr>

                    <tr class="o_subtotal" style="border-color: transparent !important;">
                        <td style="border-color: transparent !important;">
                            <strong class="me-3">BIC</strong>
                        </td>

                        <td style="border-color: transparent !important;">
                            <span t-out="o.partner_bank_id.bank_bic">BIC Number</span>
                        </td>
                    </tr>

                    <tr style="display: none">
                        <!-- Hide black last lign -->
                    </tr>
                </table>
            </div>
        </xpath>
    </template>

    <template id="report_invoice_hide_duplicate_reference" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='reference']" position="attributes">
            <attribute name="t-if">o.ref and not o.hide_duplicate_reference</attribute>
        </xpath>
    </template>

    <template id="report_invoice_hide_duplicate_customer_address" inherit_id="l10n_fr_account.report_invoice_document">
        <xpath expr="//div[@name='customer_address']/.." position="attributes">
            <attribute name="t-if">o.l10n_fr_is_company_french and o.partner_id.commercial_partner_id != o.partner_id and o.move_type.startswith('out_') and not o.hide_duplicate_customer_address</attribute>
        </xpath>
    </template>
</odoo>
