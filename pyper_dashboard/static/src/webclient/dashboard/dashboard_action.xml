<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pyper_dashboard.DashboardAction">
        <div t-attf-class="pyper_dashboard--action bg-view border {{isKpi ? 'pyper_dashboard--action-kpi' : ''}}" t-att="props.attr" t-att-style="(props.height ? 'height: ' + props.height + '; overflow: hidden;' : '') + (props.minHeight ? ' min-height: ' + props.minHeight + ';' : '') + (props.maxHeight ? ' max-height: ' + props.maxHeight + '; overflow: hidden;' : '')" t-att-data-height="props.height || undefined" t-att-data-max-height="props.maxHeight || undefined" t-att-data-min-height="props.minHeight || undefined">
            <div class="pyper_dashboard--action-header" t-attf-class="{{props.title || props.icon ? '' : 'oe_header_empty'}}" name="pyper_dashboard_action_header">
                <div t-attf-class="pyper_dashboard--action-header-title {{props.title ? '' : 'oe_header_empty'}}" t-att-title="props.title || undefined">
                    <h3 t-out="props.title"></h3>
                </div>

                <div class="pyper_dashboard--action-header-icon" t-if="props.icon">
                    <i t-att-class="props.icon"/>
                </div>
            </div>

            <t t-if="!isValid">
                <div class="text-center text-warning m-1">Invalid action</div>
            </t>

            <t t-if="isKpi and isValid">
                <div class="pyper_dashboard--kpi-body">
                    <div class="pyper_dashboard--kpi-value" t-out="formattedKpiValue"/>
                    <div class="pyper_dashboard--kpi-subtitle text-muted" t-if="kpiData.subtitle" t-out="kpiData.subtitle"/>
                </div>
            </t>

            <t t-if="showView">
                <View t-props="viewProps"/>
            </t>
        </div>
    </t>
</templates>
